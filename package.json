{
  "name": "xdu-campusmind-backend",
  "version": "1.0.0",
  "description": "XDU CampusMind 比赛演示后端，提供校园文创生成、历史记录与健康检查接口。",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "start:server": "node server.js",
    "start:client": "node client/serve-dist.cjs",
    "build:client": "npm --prefix client run build"
  },
  "keywords": [
    "express",
    "campusmind",
    "xdu",
    "ai",
    "backend"
  ],
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "openai": "^6.34.0",
    "undici": "^8.1.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.10"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
